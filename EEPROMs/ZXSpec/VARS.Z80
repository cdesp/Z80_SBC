;ORG $E200	;PARAMS
Org $0000
NOP
ORG $2200 ;MYRAMBANK IS 1 SO $2000
@BLSTACKP	DEFS 1
@OSVARS  EQU $
        @ID             DEFS 4
        @INITRUN        DEFS 1
	@OLDBNK7	DEFS 1
	@OLDSYS		DEFS 1
	@OLDSP		DEFS 2		
	@OLDHL		DEFS 2		;JUST FOR REFERENCE
	@OLDDE		DEFS 2
	@OLDBC		DEFS 2
	@OLDAF		DEFS 2
	@OLDIX		DEFS 2
	@OLDIY		DEFS 2
        @TMPCB          DEFS 2
	;SERIAL
	@SERERR 	DEFS 1
;STORAGE
        @USBBUF		DEFS 50							;CH376 USB BUFFER        
        @STRGBUFF 	DEFS 40 						;USED FOR DIRECTORY AND FILENAME
        	;UTILS
	@B2DINV 	DEFS 8		;BINARY NUMBER TO BE CONVERTED
	@B2DBUF 	DEFS 20		;ASCCI STRING OF THE NUMBER	
	@B2DEND 	DEFS 1		;0 FOR TERMINATE THE STRING
	@LINESTR:	DEFS 2		;ADDRESS OF LINEBUF FOR PRINTING ON STRING
	@LINEPOS	DEFS 1
	@RNDseed 	DEFS 1		;RANDOM SEED
	@NUMBUF		DEFS 7
	@STRG_STAT	DEFS 1
	@PRGEX		DEFS 2		;PROGRAM EXECUTE ADDRESS
	@DIRNM		DEFS 20		;DIRECTORY NAME
	@MYNUM DEFS 13 							;10CHARS MESSAGE FOR NUMBER AND 3 TERMINATED
       ;----SOUND MODULE
	@CHANDATA:       ;SONG DATA ADDRESS 0 FOR NO DATA
        DEFS 2
        DEFS 2
        DEFS 2
        DEFS 2
	@CHANDEL:	;CHANNEL DELAY TO MUTE
        DEFS 1
        DEFS 1
        DEFS 1
        DEFS 1
	@CHANST         DEFS 1    ;CHANNEL STATUS  BITS 0-3 SET MEANS DISABLED                     
        ;LOADER
        @DIROPENED       DEFS 1
        @FILEOPENED      DEFS 1
        @LASTREAD        DEFS 2
        @BYTESREAD       DEFS 2
        @TOTBYTES        DEFS 4          ;DE:BC THE FILE SIZE BC IF FILE <65K
        @BLOCKBYTES      DEFS 2
        @BLOCKTYPE       DEFS 1		 ;THIS THE FLAG BYTE
        @LASTADDR        DEFS 2
        @CHECKSUM        DEFS 1
        @DIRFILENAME     DEFS 20
	@FILENAME	 DEFS 13	; 8.3#0	
	;FOR DIRECTORY
	;BOOTLOADER
	OSBANKS		DEFS 8
	EXBANK		DEFS 1
	NUMSTR:		DEFS 3
	OSFNAME		DEFS 14
	FILEBTCNT	DEFS 2	
	;MMU
	@BANKS 		DEFS 8							;8 PAGES FOR THE 8 BANKS 0..7
	@TMPG  		DEFS 4		;TEMP PAGE FOR VIDEO VGA
	@PGSEM		DEFS 4		;PAGE SEMAPHORES TO KEEP TRACK OF PAGE CALLS
	@ROPAGES	DEFS 5		;read only OS pages

	;PS/2 KEYBOARD
	@KBDFLAG	DEFS 1
	@KEYCTR		DEFS 1
	@LASTKEY	DEFS 1	

	;VGA
	@SCRNST 	DEFS 1							;SCREEN STATUS BIT 0 ON/OFF LCD, BIT 1 ON/OFF VGA
	@VGAFCOL 	DEFS 1		;VGA FORE COLOR
	@VGABCOL 	DEFS 1		;VGA BACK COLOR
	@VGATX_X 	DEFS 1		;VGA CURRENT X POS
	@VGATX_Y 	DEFS 1		;VGA CUR Y POS
	@VGAMAXX 	DEFS 1		;MAX HORZ CHARS
	@VGAMAXY 	DEFS 1		;MAX VERT LINES
	@VGATMPC 	DEFS 1		;TMP CHAR FOR CURSOR
	@VGABUF 	DEFS 1		;BUFFER TO WRITE - BIT 0 TO SELECT
	@VGASTADR 	DEFS 2		;START ADDRESS TO CALCULATE TEXT OUTPUT

	;BOOTLOADER
	@TEMPSAVE	DEFS 2		;FOR TEMPORARY STORAGE OF ADDRESS
	@MNUITEMS	DEFS 1		;NO OF MENU ITMES
	@SELECTED	DEFS 1		;CURRENT MENU ITEM
	@PREMENU     	DEFS 1		;FOR /
    ; --- SYSTEM VARIABLES ---
	@TOTAL_ITEMS  	DEFS 1
	@TOTAL_PAGES 	DEFS 1
	@CURR_PAGE	DEFS 1
	@PAGE_ITEMS   	DEFS 1
	@MENUPTR	DEFS 2		;POINTER TO THE MENU SPACE
	@MENU		DEFS 200	;SPACE FOR MENU DATA	  
	@FILEBUFFER	DEFS 1		;ALL EXTRA SPACE TO BE USED FOR LOADING BOOT.INI ***THIS IS LAST***				
@OSVARSEND EQU $

        