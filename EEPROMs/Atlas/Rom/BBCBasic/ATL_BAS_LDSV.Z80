		MODULE BASIC_LOAD_SAVE
;Load / Save using RS232 TO CONNECT WITH THE STORAGE DEVICE ARDUINO NANO

; GLOBAL VARS FROM ATLAS O.S.		
INCLUDE ..\OSATLAS.SYM
		

FIXFNAME: LD DE, STRGBUFF
OFNXT:		LD A, (HL) 							;hl = ACCS =FILENAME ENDS WITH 0X0D
		CP 13 								;
		JR NZ, OSCONT
		XOR A
OSCONT:		LD (DE), A
		INC HL
		INC DE
		CP 0
		JR NZ, OFNXT
		RET

;HL HAS A FILENAME TERMINATED BY #13
;PAGE HAS THE START OF BASIC PROGRAM
;TOP HAS THE END OF BASIC
;BC THE BYTES TO SAVE
@MYOS_OSSAVE: 	CALL FIXFNAME ;COPY TO STRGBUFF AS NULL TERMINATED
				LD HL, STRGBUFF ;FILENAME
				LD DE, (PAGE) ;SOURCE BYTES
							  ;BC TOTAL BYTES
				CALL STRG_SAVEFILE
				JR C,SVERR
				RET

SVERR:	;	CP FNOTFND
		;JP Z, FLNOTF
		CALL EXTERR
		DEFM  "Error Saving"
		DEFB    0				


@MYOS_OSLOAD:   CALL FIXFNAME ;COPY TO STRGBUFF AS NULL TERMINATED
				LD HL, STRGBUFF ;FILENAME
				LD DE, (PAGE)   ;MEMORY ADDRESS TO LOAD
				LD BC,0			;LOAD ALL BYTES
				CALL STRG_LOADFILE
				JR C,LDERR
				RET

LDERR:	;	CP FNOTFND
		;JR Z, FLNOTF
		CALL EXTERR
		DEFM  "Error Loading"
		DEFB    0
FLNOTF:		CALL EXTERR
		DEFM  "Wrong Filename"
		DEFB    0


