Org $0000       ;SAVED INTO PAGE $8F
MAINADDR EQU $0000

		@DEVMMU EQU $00;
                @DEVSER EQU $20
                @DEVSYS EQU $E1
                @DEVSND EQU $40 ;FOR SN76489
		@DEV376 EQU $30
		@DEVKBI EQU $48

		@FONT_ADDR EQU $00	;FONT ALREADY LOADED 
		@VIDPG 	EQU $C0		;WAS 8 DPVRAM START PAGE TOTAL 8 64KB ON 2 BUFFERS 0 AND 1

                @MMU_PORT EQU DEVMMU
                @MMU_READ_PORT EQU DEVMMU


DI
JP SHOWDIR
DS MAINADDR+0066H-$
DI
JP SHOWDIR


