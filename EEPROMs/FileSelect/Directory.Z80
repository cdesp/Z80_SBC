
       
	@MYRAMBANK EQU 1; AT $2000

	;SYSTEMS
	@BOOTLOADER	EQU 0 ;NOT USED
	@ATLAS 		EQU 1 ;NOT USED
	@NEWBRAIN 	EQU 2 ;NOT USED
	@ZXSPECTRUM 	EQU 3
	@AMSTRAD 	EQU 4

	PGRAMST		EQU $1A ;STARTING PAGE AT RAM TO FIT 819200 BYTES
	PGTMP 		EQU NUMBUF
	PGOLD		EQU NUMBUF+2

	@DIRECTORY DEFM "/"
        DB 0
	@DIR_ZX DEFM "SPECTRUM"	;8 CHARS
        DB 0
	@DIR_AM DEFM "AMSTRAD " ;8 CHARS
        DB 0

	@DEMOFNAME  DEFM "SPECMAN .TAP"
        DB 0	

	@DIROPNERR  DEFM "ER OPEN DIR"
        DB 0             

	TZX_FILE DEFM ".TZX"
	DB 0

	CDP_FILE DEFM ".CDP"
	DB 0

	TAPE_PRT EQU $E5 ;TAPE PORT REGISTER


@MYDISKERROR:   CALL RS_TXT
                CALL RS_NEWLINE
                RET	  

;@BEF_SP_CHANGE EQU DO_SP_CHANGE		;NOTHING TO DO HERE	
;@EX_BF_SP_CHNG EQU EX_DO_SP_CHNG	;NOTHING TO DO HERE

;MAIN ROUTINE  FOR NMI ENTRY 0066H
@SHOWDIR:
		PUSH AF		;save old regs on old sp
		PUSH BC
		PUSH DE
		PUSH HL
		PUSH IX
		PUSH IY
		;READ SYSTEM PAGES AND SYSTEM SAVE THEM ON OUR VAR PAGE
		IN A,(DEVSYS)           ;current system should be saved and
		LD D,A			;SAVE TO D
                XOR A
                OUT (DEVSYS),A          ;SET NEW SYSTEM  0 AS BOOTLOADER 				
		LD B,MYRAMBANK		;READ OLD page  OF our ram bank
		CALL MMU_READ	;A THE PAGE
		LD E,A 		;SAVE TO E
		LD A,$7F	;LAST RAM PAGE IS OUR VAR PAGE ON BANK 7
		LD B,MYRAMBANK
		SLA B 
		SLA B 
		SLA B 
		SLA B 
		SLA B 
		LD C,DEVMMU
		OUT (C),A	;CANT USE MMU SET CALL HERE SAFELY
		CALL CHECKID
		JR C,SKIP1 ;not used cause we have to clear the ram page on bootloader or on fpga on reset
		LD A,E 		;RESTORE A AS OLD PAGE ON 7
		LD (OLDBNK7),A  ;SAVE AS VAR
                LD A,D 		
		LD (OLDSYS),A   ;SAVE SYS VAR	
		CALL PRINT_A		
		;CHANGE SP
SKIP1:		LD HL,0
		ADD HL,SP 	;HL HAS THE SP
		LD (OLDSP),HL		
		LD SP,BLSTACKP	;RAM TOP		
		
		;MAIN WORK SHOW THE MENU AND SELECT AN ITEM
		CALL INITMENU
		LD A,1
		LD (SCRNST),A
		LD A,(DIROPENED)
                OR A 
		JR NZ, DIROPNED
                LD HL,DIRNM
                LD A,'\' ;'
                LD (HL),A 
                INC HL
                XOR A 
                LD (HL),A 
                INC HL
                LD (HL),A 
		LD A,(OLDSYS) ;GET CURRENT SYSTEM
		CP ZXSPECTRUM
		JR NZ, NXTSYS1
		LD HL, DIR_ZX
		JR SETDIR
NXTSYS1:	CP AMSTRAD		
		JR NZ,DEFSYS
		LD HL, DIR_AM
		JR SETDIR
DEFSYS:         LD HL,DIRECTORY
                ;OPEN HE DIRECTORY
SETDIR:         CALL STRG_DIRNMCHG        ;THIS PUTS THE NEW DIR ON THE DIRNM VAR
                CALL STRG_OPENCDIR      ;THIS OPENS THE DIRNM VAR	
		JR NC,DIROP
                LD HL,DIROPNERR
                JP MYDISKERROR		
DIROP:		LD A,1
		LD (DIROPENED),A
DIROPNED: 	CALL  OS_PRINTMSG
		DEFM "DIR OPENED"
		DB 0
		LD HL,MENU
		LD (MENUPTR),HL
		CALL STRG_DIRLIST	;THIS CALLS MNG_DIR_ENTRY FOR EACH DIR ENTRY
		LD HL,(MENUPTR)
		XOR A 
		LD (HL),0		;SIGNAL END OF MENU
		INC HL
		LD (HL),0
		CALL GETMNUSEL
		JR NC, MENUOK
		CALL  OS_PRINTMSG
		DEFM "MENU EMPTY OR CANCEL!"
		DB 0
		JP DOEXIT		

		;HL POINTS TO THE STRING SELECTED
		;A POINTS TO THE NUMBER ON THE LIST
		;CALL RS_RX
MENUOK:		LD A,12
		LD (VGATX_X),A
		LD A,2
		LD (VGATX_Y),A		   
		LD DE,FILENAME
		PUSH DE
		LD BC,12	;8.3
		LDIR ;COPY TO FILENAME
		XOR A 
		LD (DE),A	;NULL TERMINATE
		CALL STRG_CLSFILE ;CLOSE FILE IF ONE IS OPENED
		POP HL
		CALL OS_PRINTTEXT
		CALL NO_TAPE 	;SIGNAL FPGA NO TAPE
		LD HL,FILENAME
		LD DE,TZX_FILE
		CALL CHK_SUBSTR
		JR NC, FILECOPY  ; FOUND
		LD HL,FILENAME
		LD DE,CDP_FILE  ; IT IS A CDT FILE I JUST PUT P TO DISTINGUISH THE PULSE 
		CALL CHK_SUBSTR
		JR NC, FILECOPY  ; FOUND
		;HERE IF NOT FOUND		
		JP DOEXIT ;NO COPY
FILECOPY:;;COPY FILE TO RAM
		CALL  OS_PRINTMSG
		DEFM "COPYING FILE TO RAM"
		DB 0
                LD HL,FILENAME             ;DEFAULT DEMOFNAME
                CALL COPYFNAME
                XOR A                      ; Read-only
                CALL STRG_OPNFILE
                JR Z, DOCOPY
		CALL  OS_PRINTMSG
		DEFM "ERROR OPENING FILE"
		DB 0
                JP DOEXIT   

DOCOPY:		LD B,4
		CALL MMU_READ
		LD (PGOLD),A

		LD A, PGRAMST
		LD (PGTMP),A
		
		
DCP_LOOP:	
		LD A,(PGTMP)
		LD B, 4	;BANK 4
		CALL PUTPGINBANK

                LD DE,$8000 ;START OF BANK 4
                LD BC,$2000
                CALL STRG_BLKREAD                              
                JP NZ, ERROREXIT
		LD A, $20
		CP H
		JR NZ, COPDN
		XOR A
		CP L
		JR NZ, COPDN
		LD HL,PGTMP
		INC (HL)		;NEXT PAGE
		JR DCP_LOOP


COPDN:		LD A,(PGTMP)
		CALL PRINT_A
		CALL  OS_PRINTMSG
		DEFM "COPY DONE"
		DB 0
		CALL RS_NEWLINE
		CALL STRG_CLSFILE
		LD A,(PGOLD) ;RESTORE OLD PAGE
		CALL PRINT_A
		LD B, 4	;BANK 4
		CALL PUTPGINBANK				
		CALL RS_NEWLINE
		XOR A
		LD (DIROPENED),A
		LD (FILEOPENED),A
		CALL SET_TAPE	;SIGNAL FPGA WE COPIED A FILE TO RAM
		JR DOEXIT


ERROREXIT:	CALL  OS_PRINTMSG
		DEFM "ERROR LOADING FILE"
		DB 0


DOEXIT:		;RESTORE SYSTEM PAGES AND SYSTEM AND EXIT
		;RESTORE SP
		LD HL,(OLDSP)		
		LD SP,HL	;SP RESTORED VARS NO LONGER NEEDED
		LD A,(OLDSYS) 
		LD D, A
		LD A,(OLDBNK7)
		LD B,MYRAMBANK
		SLA B 
		SLA B 
		SLA B 
		SLA B 
		SLA B 		   
		LD C,DEVMMU
		OUT (C),A       ;WE CAN'T USE CALL HERE SAFELY
		LD A,D 		 
                OUT (DEVSYS),A          ;SET SYSTEM BACK	
		POP IY
		POP IX
		POP HL
		POP DE
		POP BC
		POP AF
		EI
		RETN


SET_TAPE:	LD A,1
		OUT (TAPE_PRT),A
		RET

NO_TAPE:	LD A,0
		OUT (TAPE_PRT),A
		RET

;==============================================================================
; CHK_SUBSTR
; Checks if ZT substring (DE) is contained in ZT main string (HL).
; Returns: 
;   - NC and A = 0-based offset index if found
;   - C if substring is not found
;==============================================================================
CHK_SUBSTR:
    LD   B, 0               ; B = current match start index (0 to 255)

.outer_loop:
    LD   A, (HL)            ; Read current character from main string
    OR   A                  ; Is main string at end (0x00)?
    JR   Z, .not_found      ; If main string ended, substring was not found

    ; Save pointers to test candidate match at current position
    PUSH HL
    PUSH DE

.inner_loop:
    LD   A, (DE)            ; Read character from substring
    OR   A                  ; Is substring at end (0x00)?
    JR   Z, .match_found    ; Reached end of substring -> Complete match!

    LD   C, A               ; C = current substring character
    LD   A, (HL)            ; A = current main string character
    CP   C                  ; Do the characters match?
    JR   NZ, .no_match      ; Mismatch -> exit inner loop

    INC  HL                 ; Advance both pointers
    INC  DE
    JR   .inner_loop

.no_match:
    ; Clean up stack, advance outer index and pointer
    POP  DE                 ; Restore original DE (substring head)
    POP  HL                 ; Restore original HL (main string position)
    INC  HL                 ; Move to next candidate position in main string
    INC  B                  ; Increment candidate position index
    JR   .outer_loop

.match_found:
    ; Substring matched completely
    POP  DE                 ; Restore stack
    POP  HL
    LD   A, B               ; A = 0-based starting index
    OR   A                  ; Clear Carry Flag (NC)
    RET

.not_found:
    SCF                     ; Set Carry Flag (C) to indicate failure
    RET


;THIS ONE IS CALLED FOR EACH DIR ENTRY 32BYTES
;DATA IN USBBUF ON HL
;0x00	8 bytes	DIR_Name
;0x08	3 bytes	DIR_Extension
;0x0B	1 byte	DIR_Attr (ReadOnly, Hidden, System, Volume, Directory, Archive)
;0x0C	1 byte	DIR_NTRes
;0x0D	1 byte	DIR_CrtTimeTenth
;0x0E	2 bytes	DIR_CrtTime
;0x10	2 bytes	DIR_CrtDateFile
;0x12	2 bytes	DIR_LstAccDate
;0x14	2 bytes	DIR_FstClusHI
;0x16	2 bytes	DIR_WrtTime
;0x18	2 bytes	DIR_WrtDate
;0x1A	2 bytes	DIR_FstClusLO
;0x1C	4 bytes	DIR_FileSize


@MNG_DIR_ENTRY: 
		LD A,(HL)		
		CP '.'
		RET Z 	;SKIP IF DIR CUR OR BACK
		LD DE,(MENUPTR)
		;HL THE FILE STRUCT				
		PUSH HL
		POP IX ;IX THE FILE STRUCT
		LD BC,8
		LDIR  	;COPY FILENAME
                LD A,'.'
		LD (DE),A
                INC DE
		LD BC,3
		LDIR	;COPY EXTENSION
		LD A,' '
		LD (DE),A
		INC DE
		LD A,' '
		LD (DE),A
		INC DE
		PUSH IX
		POP HL
		LD BC, $1C 
		ADD HL,BC
		CALL CNVTOKB
		LD A,C 		;BC HAS THE KB SUPPORT UP TO 255KB
		PUSH DE
		CALL B2D8
		POP DE
                LD HL,B2DBUF
		CALL SKIPSPC
DE_NEXT:	LD A,(HL)
		OR A 
		JR Z, DE_OVER
		LD (DE),A
		INC DE
		INC HL
		JR DE_NEXT
DE_OVER:	LD A,'K'
		LD (DE),A 
		INC DE
		LD A,'B'
		LD (DE),A 
		INC DE
                XOR A
		LD (DE),A
		INC DE
		LD (MENUPTR),DE	;NEXT ENTRY POINTER
		LD A,'*'
		CALL RS_TX		
		RET

;HL POINTS TO 32BIT (4BYTES), LITTLE-ENDIAN (LSB FIRST)
;RETURN BC HAS THE KBs (VALUE >> 10, LOW 16 BITS)
;DESTROYS: A, HL
CNVTOKB:
		PUSH DE
		INC   HL        ;SKIP BYTE0 (LSB) - LOST IN >>10 ANYWAY
		LD    E,(HL)    ;E = BYTE1
		INC   HL
		LD    D,(HL)    ;D = BYTE2
		INC   HL
		LD    A,(HL)    ;A = BYTE3 (MSB)

		;SHIFT THE 24-BIT VALUE A:D:E RIGHT BY 2 (TOTAL SHIFT = 8+2 = 10)
		SRL   A
		RR    D
		RR    E
		SRL   A
		RR    D
		RR    E

		LD    C,E
		LD    B,D
		POP DE
		RET

