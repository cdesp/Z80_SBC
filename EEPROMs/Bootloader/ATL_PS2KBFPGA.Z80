;USE PS2ISK TO CHECK IF A KEY IS AVAILABLE
;USE READCHAR TO GET THE KEY TRANSLATED TO CHAR
		
;NEEDS VAR KBDFLAG BIT 7=AVAIL KEY, 2,1,0 CAPS, NUM SCROLL LOCK
;NEEDS VAR LASTKEY
;NEEDS VAR KEYCTR     BIT 4 CAPSLOCK ON/OFF
		
		GLOBAL PS2KBINIT
		GLOBAL PS2ISK 							;IS KEY AVAILABLE
		GLOBAL READCHAR 						;GET A CHAR NOT BLOCKING RETURNS ZERO IF NO KEY -- STRIPS KEYBOARD CODES TRANSLATE TO A CHAR
		GLOBAL GETKEYPR 						;GETS A RAW KEY FROM KEYBOARD WHEN AVAILABLE (BLOCKS UNTIL KEY PRESS)
		GLOBAL GETKEYPRNB 						;GETS A RAW KEY FROM KEYBOARD (NO BLOCK IT HAS A TIMEOUT CHECK Z=0 NO TIMEOUT AND A=0)
		GLOBAL PS2SETKEYAV
		GLOBAL PS2NOKEYAV
		GLOBAL SETCPSLOCK
		GLOBAL RESETCPSLOCK
		GLOBAL SETNUMLOCK
		GLOBAL RESETNUMLOCK
		GLOBAL SETSCRLOCK
		GLOBAL RESETSCRLOCK
		
		
SETSCRLOCK:	
		LD HL, KBDFLAG
		SET 0, (HL)
		CALL SETLOCKS
		RET
		
RESETSCRLOCK:	
		LD HL, KBDFLAG
		RES 0, (HL)
		CALL SETLOCKS
		RET
		
SETNUMLOCK:	
		LD HL, KBDFLAG
		SET 1, (HL)
		CALL SETLOCKS
		RET
		
RESETNUMLOCK:	
		LD HL, KBDFLAG
		RES 1, (HL)
		CALL SETLOCKS
		RET
		
SETCPSLOCK:	
		LD HL, KBDFLAG
		SET 2, (HL)
		CALL SETLOCKS
		RET
		
RESETCPSLOCK:	
		LD HL, KBDFLAG
		RES 2, (HL)		
		CALL SETLOCKS
		RET
		
;SETS A FLAG THAT WE HAVE A KEY AVAILABLE FROM KEYBOARD
;FOR USE FROM THE INTERRUPT SERVICE
PS2SETKEYAV:	LD HL, KBDFLAG
		SET 7, (HL)
		RET
		
;RESET THE KEYB FLAG
PS2NOKEYAV:	LD HL, KBDFLAG
		RES 7, (HL)
		RET
		
;RETURNS THE KEY PRESSED TRANSLATED TO CHAR
;SAVES THE LAST KEYCODE
READCHAR:	CALL GTKEY
		OR A
		RET Z 								;NO KEY IF A=0
		LD (LASTKEY), A
		CALL PS2LOK 							;LOOK UP TABLE TRANSLATION
		RET
		
;CHECKS IF A KEY IS AVAILABLE
;RETURN  ZERO FLAG SET (NZ )IF  KEY AVAILABLE
PS2ISK:		IN A,(DEVKBI+1)
		BIT 0,A ; IF Z THEN NO KEY AVAILABLE
		RET
		
;RETURNS THE KEY CODE PRESSED ALSO CHECKS THE EXTENDED KEYS AND SETS SHIFT CONTROL ETC
GTKEY:		CALL NGETKEY 							;GET A KEY FROM PS2 HARDWARE
		OR A
		RET Z
		CALL CHECKEXT 							;CHECK FOR EXTDED KEYS
;CHECK FOR CAPS LOCK AND SET THE LED ON KEYBOARD
		LD HL, KEYCTR
		BIT 4, (HL) 							;BIT 4 IS CAPS LOCK
		JR Z, RESETCPSLOCK 						;RETURNS THIS ROUTINE
		JR SETCPSLOCK 							;RETURNS THIS ROUTINE
		
;ACCESS THE FPGA
;------------------------------------------------------------------------------------
PS2KBINIT:	CALL PS2NOKEYAV
		XOR A
		LD (LASTKEY), A
		RET
		
;PS2KEYB ON FPGA SETS BIT 0 ON IN PORT+1 ALSO BIT7 IF BUSY SENDING
;GETS A KEY FROM THE PS2KEYB FPGA
;RETURN THE KEY PRESSED ON A,C
;DESTROYS A,B,L,C
NGETKEY:	DI
		IN A, (DEVKBI + 1)
		BIT 0, A
		JR NZ, FPGAKEY
		XOR A 								;RETURNS 0 IF NO KEY AVAILABLE
		RET
FPGAKEY:	IN A, (DEVKBI) 							;GET ETHE KEY
		EI 								;CLEAR INTERRUPT
;DELAY
		CALL PS2NOKEYAV 						;READY FOR NEXT KEY
		RET
		
;THIS GETS A KEYPRESS -- ATTENTION IT BLOCKS UNTIL WE GET A KEYPRESS
GETKEYPR:	IN A, (DEVKBI + 1) 						;GET KEYBOARD STATUS
		BIT 0, A
		JR Z, GETKEYPR
		IN A, (DEVKBI)
		RET
		
;THIS GETS A KEYPRESS NO BLOCK HERE
;Returns: A = Keypress (if Z=0), or Z=1 if timeout occurred
		
GETKEYPRNB:	
		LD BC, $2000 							; Set your timeout threshold (adjust as needed)
		
GETKEY_LOOP:	
		IN A, (DEVKBI + 1) 						; Check keyboard status
		BIT 0, A
		JR NZ, KEY_READY 						; If Bit 0 is 1, key is waiting!
		
		DEC BC 								; Decrement the counter
		LD A, B
		OR C 								; Check if BC is 0000
		JR NZ, GETKEY_LOOP 						; If not zero, keep waiting
		
; Timeout reached!
		XOR A 								; Clear A and set Z=1 to indicate timeout
		RET 								; Return with Z=1
		
KEY_READY:	
		IN A, (DEVKBI) 							; Get the actual key
		OR A 								; Reset Z flag (Z=0) so the caller knows it succeeded
		RET 								; Return with Z=0 and A=Keypress
		
;BIT 0          SCROLL
;BIT 1          NUM
;BIT 2          CAPS
;HL THE FLAG VARIABLE
@SETLOCKS:	PUSH AF
		LD A,(HL)
		PUSH AF
RESEND:		LD A, $ED
		OUT (DEVKBI), A 						; Send LED data to the bridge
		
DA1:		IN A, (DEVKBI + 1)
		SLA a
		JR C, DA1
		
		CALL GETKEYPR 							;;should be $FA
		CP $FA
		JR Z, ALLOK
		CP $FE
		JR Z, RESEND
		
ALLOK:		POP AF
		AND 7
		OUT (DEVKBI), A 						; Send LED data to the bridge
		CALL GETKEYPR 							;;should be $FA
		CP $FA
		POP AF
		RET
		
		
		
		INCLUDE ATL_PS2KBTRANS.Z80
