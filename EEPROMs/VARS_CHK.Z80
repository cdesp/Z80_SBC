;ROUTINE THAT CHECKS IF THIS IS THE FIRST TIME RUNNING TO INITIALIZE VAR
@CHECKID:	PUSH DE
		LD A,(ID)
		CP $14
		JR NZ,FIRST
		LD A,(ID+1)
		CP $34
		JR NZ, FIRST
		LD A,(ID+2)
		CP $94
		JR NZ, FIRST
		LD A,(ID+3)
		CP $194
		JR NZ, FIRST
		POP DE
		SCF
		RET

@FIRST:         LD HL,OSVARS
		XOR A
		LD (HL),A
		LD DE,OSVARS+1
		LD BC,OSVARSEND-OSVARS
		LDIR
		LD A,$14
		LD (ID),A
		LD A,$34
		LD (ID+1),A
		LD A,$94
		LD (ID+2),A
		LD A,$194
		LD (ID+3),A
		LD A,1
		LD (INITRUN),A
		LD HL,DEMOFNAME
		LD DE,FILENAME
		LD BC,13
		LDIR
		LD A,1
		LD (SCRNST),A
		POP DE
		AND 1		
		RET