

;HL POINTS TO ZERO TERMINATED MSG
;IX,A DESTROYED
@OS_PRINTTEXT:	LD A,(HL)
		CP 0
		RET Z
		PUSH HL
		CALL OS_PRINTCHAR
		POP HL
		INC HL
		JR OS_PRINTTEXT 
;PRINTS A ZT MESSAGE FOLLOWING THE CALL TO RS232 AND MAYBE TO SCREEN
@OS_PRINTMSG:	POP HL
		PUSH HL
		CALL RS_TXT ; PRINTS A ZT STRING ON HL 
		POP DE  ;DE ON STRING
		PUSH HL ;CONTINUE AFTER THE MESG	
		; DO OTHER STUFF WITHT THE STRING ADDESS LIKE PRINT ON SCREEN STRING ON DE
		
		RET
;PRINTS A ZT MESSAGE FOLLOWING THE CALL
@OS_PRNMSGSCR:	POP HL
                CALL OS_PRINTTEXT	;SERIAL AND SCREEN
		INC HL
		PUSH HL			;CONTINUE AFTER THE MESG	
		RET



;PRINTS A CHAR TO THE OS SCREEN		
;A HAS THE CHAR
;FLAGS MUST BE RETAINED NO CARRY FLAG MEANS BACKSPACE IS GO LEFT
@OS_PRINTCHAR:	PUSH AF
OSPCNX:		POP DE
		LD A,(SCRNST)
		OR A
		RET Z
		PUSH DE
		POP AF				;GET THE FLAGS BACK AND THE CHAR
		PUSH AF
		CALL RS_TX
		POP AF		
		CALL VGA_PRCH	
		RET

@OS_PRNCHARSFE:	PUSH HL
		PUSH BC
		CALL OS_PRINTCHAR
		POP BC
		POP HL
		RET

@OS_NEWLINE:	LD A,10
		CALL OS_PRNCHARSFE 
		LD A,13
		CALL OS_PRNCHARSFE 
		RET

@OS_PRMESSCR:   LD A,(HL)
		OR A
		RET Z
		CALL RS_TX
                INC HL
		JR OS_PRMESSCR
;SAFE PRINT TO SCREEN SAVES HL
@OS_PRMESSCRSFE: PUSH HL
                PUSH BC
                PUSH AF
                CALL OS_PRMESSCR
                POP AF
                POP BC
                POP HL
                RET

@OS_PRCHSCR	EQU RS_TX


OS_NEWLINE:	LD A,10
		CALL OS_PRNCHARSFE 
		LD A,13
		CALL OS_PRNCHARSFE 
		RET


@PRINT_A:       PUSH AF
                PUSH HL
                PUSH DE
                PUSH BC
                CALL B2D8
                LD HL,B2DBUF
                CALL RS_TXT
                CALL RS_NEWLINE
                POP BC
                POP DE
                POP HL
                POP AF
                RET        

@PRINT_HL:      PUSH AF
                PUSH HL
                PUSH DE
                PUSH BC
                CALL B2D16
                LD HL,B2DBUF
                CALL RS_TXT
                CALL RS_NEWLINE
                POP BC
                POP DE
                POP HL
                POP AF
                RET     


@SOUTAS:	PUSH HL
		PUSH BC
		PUSH DE
		PUSH AF 							;SERIAL PRINT ASCII IN DECIMAL
		LD H, 0
		LD L, A
		LD DE, MYNUM
		CALL OUTASC
		
		LD A, 10
		LD (DE), A
		INC DE
		LD A, 13
		LD (DE), A
		INC DE
		XOR A
		LD (DE), A
		
		LD HL, MYNUM
		CALL OS_PRINTTEXT
		POP AF
		POP DE	
		POP BC
		POP HL
		RET


;TEST KEY PRESSED EITHER RS232 OR PS2
@GET_KBCHAR:	XOR A		
;GET CHAR FROM RS232
		CALL RS_KEYRD 							;CHAR IN RS232?
		JR Z, GT_TST2
		CALL RS_RX 							; GET THAT CHAR
		RET
;GET CHAR FROM PS2 KEYBOARD
GT_TST2:	CALL PS2ISK 						;ZF=1 IF WE HAVE A KEY ELSE 0
		JR Z, GET_KBCHAR 						;RECHECK
		CALL READCHAR
		OR A
		JP Z,GET_KBCHAR		
		RET