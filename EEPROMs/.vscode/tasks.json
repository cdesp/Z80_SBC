{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Raw Flash Binary",
      "type": "shell",
      "command": "make",
      "args": [
        "-C",
        "neorv32",
        "clean",
        "raw"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}